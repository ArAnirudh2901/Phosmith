{"nodes": [{"id": "readme_phosmith", "label": "Phosmith \u2014 AI Image Studio (README)", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_megashader_engine", "label": "Megashader WebGL2 Compositing Engine", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each mask layer stores parameters, not pixels, so it stays fully editable; the chain recompiles and re-renders at 60fps and is pinned by 230 GLSL invariant tests."}, {"id": "readme_agent_command_system", "label": "Agent Command System (mask./crop./collage. domains)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Domains are registered by canvas.jsx on editor mount and exposed as window.__phosmith.agent; every run is logged in the History panel with a cyan Bot badge, separate from user changes."}, {"id": "readme_masking_tools", "label": "Mask Tool Taxonomy (AI / Draw / Range / Destructive)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All non-destructive selections become reorderable, toggleable, invertible megashader mask layers; only Quick Erase modifies pixels."}, {"id": "readme_mask_boundary_extension", "label": "Mask Boundary Extension (Boundary slider)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Grows/shrinks by an absolute px amount from the pristine texture kept under baseTextureKey, so setting 0 always restores the original edge (non-cumulative)."}, {"id": "readme_ai_object_remover", "label": "AI Object Remover (click -> SAM -> LaMa)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Professional-eraser behaviour: the object is segmented AND the hole is filled with plausible background, rather than cut to transparency. LaMa local-first with HF Stable Diffusion fallback, cropped to padded mask bounds."}, {"id": "readme_nl_masking", "label": "Natural-Language Masking", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "mask.fromDescription chains CLIPSeg grounding + SAM refinement so each plan step lands as its own editable layer."}, {"id": "readme_auto_crop", "label": "AI Auto-Crop (4 strategies)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "subject-aware, aspect-ratio, content-fill and depth-guided boxes are proposed and previewed in the existing crop overlay before the user commits."}, {"id": "readme_ai_agent", "label": "AI Agent (Agentic Editing) prompt routing", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prompts route to collage (COLLAGE_INTENT_RE), edit (Gemini grade loop: executor -> judge -> critic -> corrective re-plan, max 3 iterations) or mask (NL -> CLIPSeg + SAM) paths."}, {"id": "readme_adjust_parameters", "label": "Adjust Tool Parameter Set (15+ sliders)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Brightness/contrast/saturation/vibrance/exposure/temperature/tint/hue/highlights/shadows/sharpness/blur/noise/film grain/curves, all computed live in WebGL2."}, {"id": "readme_local_ai_services", "label": "Local AI Services Setup & Verification", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without the service SAM/Depth/YOLO/CLIPSeg/LaMa return 501 and Select Subject falls back to HuggingFace; the editor is designed to stay usable degraded."}, {"id": "readme_deployment_hf_space", "label": "Production Deployment: Vercel + Hugging Face Space", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HF Spaces gives a free 16 GB CPU container; the Space must be Public so Vercel's backend can query it without OAuth. Free Spaces sleep after 48h and take 30-60s to wake, so ping /health on a cron to avoid timeouts. MASK_SERVICE_URL must have no trailing slash."}, {"id": "readme_agpl_license", "label": "AGPL-3.0 Licensing Decision", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Phosmith is a build input to Mask Studio, which bundles src/lib/megashader and the mask UI and is AGPL because of a YOLOE-derived detector; AGPL on Phosmith is what lets the two combine. AGPL section 13 means a hosted deployment must offer source, typically via a 'Source' link in the app shell."}, {"id": "readme_birefnet", "label": "BiRefNet (subject segmentation)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_sam2", "label": "SAM 2 (point/box segmentation)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_depth_anything_v2", "label": "Depth Anything V2 (monocular depth)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_yolo26n_seg", "label": "YOLO26n-seg (multi-instance detection)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_clipseg", "label": "CLIPSeg (open-vocabulary text grounding)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_lama", "label": "LaMa (object removal inpainting)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_rmbg_14", "label": "RMBG-1.4 (client-side background removal)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_flux1", "label": "FLUX.1 (AI background generation)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "readme_phosmith", "target": "agent_overview_phosmith_architecture", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_phosmith", "target": "readme_megashader_engine", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_phosmith", "target": "readme_agent_command_system", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": 