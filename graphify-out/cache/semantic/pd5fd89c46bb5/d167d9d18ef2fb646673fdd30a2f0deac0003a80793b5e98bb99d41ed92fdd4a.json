{"nodes": [{"id": "mockups_mask_lab_py_readme_mask_lab", "label": "Phosmith Mask Lab (Python CLI/Gradio tool)", "file_type": "document", "source_file": "mockups/mask-lab-py/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A real (not stubbed) masking pipeline proven outside the editor first; it reuses the segment service venv so it needs no new installs except optional gradio."}, {"id": "mockups_mask_lab_py_readme_masking_pipeline", "label": "Coarse -> Trimap -> Matte -> Refine -> Decontaminate pipeline", "file_type": "concept", "source_file": "mockups/mask-lab-py/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only the coarse segmenter stands in for SAM 3.1; every later stage is production math, so the fine-matte stage recovers hair/fur regardless of which coarse engine was used."}, {"id": "mockups_mask_lab_py_readme_coarse_stage", "label": "Stage 1 \u2014 Coarse mask (rembg / GrabCut / saliency)", "file_type": "concept", "source_file": "mockups/mask-lab-py/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "rembg wins on real photos (it is the model the FastAPI service ships); GrabCut wins when the subject is centred with clear contrast. Upgrade path is SAM 3.1 point/box/text, already wired as _load_sam3."}, {"id": "mockups_mask_lab_py_readme_trimap_stage", "label": "Stage 2 \u2014 Trimap (OpenCV erode/dilate band)", "file_type": "concept", "source_file": "mockups/mask-lab-py/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Identical to Matte-Anything's generate_trimap and marked 'unchanged' on the upgrade path; wider band recovers more hair at the cost of speed."}, {"id": "mockups_mask_lab_py_readme_fine_matte_stage", "label": "Stage 3 \u2014 Fine matte (PyMatting closed-form / KNN)", "file_type": "concept", "source_file": "mockups/mask-lab-py/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Closed-form matting is where quality is won on hair/fur; when ZIM or ViTMatte is dropped in, PyMatting demotes to a polish pass rather than being removed."}, {"id": "mockups_mask_lab_py_readme_decontaminate_stage", "label": "Stage 5 \u2014 Decontaminate (PyMatting estimate_foreground_ml)", "file_type": "concept", "source_file": "mockups/mask-lab-py/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Foreground colour estimation unmixes background bleed out of semi-transparent edge pixels; skippable with --no-decon."}, {"id": "mockups_mask_lab_py_readme_zim_upgrade", "label": "ZIM (zim_vit_l) drop-in matting upgrade", "file_type": "concept", "source_file": "mockups/mask-lab-py/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replacing fine_matte() with a ZimPredictor call keeps the surrounding trimap/refine/decontaminate stages untouched \u2014 the pipeline was shaped so each stage is swappable."}], "edges": [{"source": "mockups_mask_lab_py_readme_mask_lab", "target": "mockups_mask_lab_py_readme_masking_pipeline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "mockups/mask-lab-py/README.md", "source_location": null, "weight": 1.0}, {"source": "mockups_mask_lab_py_readme_masking_pipeline", "target": "mockups_mask_lab_py_readme_coarse_stage", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "mockups/mask-lab-py/README.md", "source_location": null, "weight": 1.0}, {"source": "mockups_mask_lab_py_readme_masking_pipeline", "target": "mockups_mask_lab_py_readme_trimap_stage", "relation": "references", "confide