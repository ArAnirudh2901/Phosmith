{"nodes": [{"id": "services_masking_requirements_masking_service_deps", "label": "Masking service Python dependency set", "file_type": "document", "source_file": "services/masking/requirements.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "services_masking_requirements_numpy_sam3_pin", "label": "numpy<2 pin chain for sam3", "file_type": "rationale", "source_file": "services/masking/requirements.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "sam3 requires numpy<2, so rembg is capped below 2.0.70 and opencv below 4.11 \u2014 raising either floor transitively pulls numpy 2.x and breaks the sam3 import."}, {"id": "services_masking_requirements_triton_stub", "label": "CPU triton stub (_ensure_triton_stub)", "file_type": "rationale", "source_file": "services/masking/requirements.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "sam3 hard-imports NVIDIA triton, which has no macOS/Apple-Silicon wheel. main.py installs a CPU stub so the import succeeds; sam3.perflib already dispatches NMS / connected components to numpy/skimage off-GPU. On a CUDA host the real triton is used and the stub is a no-op."}, {"id": "services_masking_requirements_sam3_undeclared_deps", "label": "sam3's undeclared runtime deps (einops, pycocotools, opencv)", "file_type": "rationale", "source_file": "services/masking/requirements.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "sam3.sam.rope imports einops and sam3.train.data needs pycocotools, but neither is declared in package metadata, so both are pinned here explicitly."}, {"id": "services_masking_requirements_sam3_gated_install", "label": "SAM 3.1 gated install (not on PyPI)", "file_type": "rationale", "source_file": "services/masking/requirements.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Meta's package installs from GitHub and the facebook/sam3.1 checkpoint needs an accepted licence plus hf login; without it every SAM-3 route degrades to the saliency/None fallback rather than erroring."}, {"id": "services_masking_requirements_sam3_refine_matting", "label": "SAM3_REFINE_MATTING alpha-matting refinement", "file_type": "concept", "source_file": "services/masking/requirements.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PyMatting closed-form is the quality path for hair-level edges; the cv2 guided-filter fallback needs only opencv, so the feature degrades instead of requiring pymatting."}], "edges": [{"source": "services_masking_requirements_masking_service_deps", "target": "services_masking_requirements_numpy_sam3_pin", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "services/masking/requirements.txt", "source_location": null, "weight": 1.0}, {"source": "services_masking_requirements_masking_service_deps", "target": "services_masking_requirements_triton_stub", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "services/masking/requirements.txt", "source_location": null, "weight": 1.0}, {"source": "services_masking_requirements_masking_service_deps", "target": "services_masking_requirements_sam3_undeclared_deps", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "services/masking/requirements.txt", "source_location": null, "weight": 1.0}, {"source": "services_masking_requirements_masking_service_deps", "target": "services_masking_requirements_sam3_gated_install", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "services/masking/requirements.txt", "source_location": null, "weight": 1.0}, {"so