{"nodes": [{"id": "mockups_mask_lab_index_select_and_mask_mockup", "label": "Mask Lab \u2014 Select & Mask pipeline mockup (browser)", "file_type": "document", "source_file": "mockups/mask-lab/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single standalone HTML file, no build step and zero model downloads: the deep models are swapped for fast classical equivalents so the refine math you would actually ship can be evaluated offline."}, {"id": "mockups_mask_lab_index_ink_depths_palette", "label": "'Ink Depths' palette + 4-area app shell layout", "file_type": "concept", "source_file": "mockups/mask-lab/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CSS vars mirror src/app/globals.css (accent #53D8FF on void blacks) and the grid is topbar / tool-rail / stage / properties / pipeline strip so the mockup reads as the real editor."}, {"id": "mockups_mask_lab_index_production_mapping", "label": "Production mapping modal (mockup stage -> real model)", "file_type": "concept", "source_file": "mockups/mask-lab/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each stage is tagged sim or real in the UI and the modal states the exact production wiring: SAM 3.1 via /api/ai/sam2 + /api/ai/ground, a new lazy-loaded /matte endpoint for ZIM/ViTMatte, PyMatting behind a quality toggle, and a final maskTextureKey on a megashader chain layer."}, {"id": "mockups_mask_lab_index_view_modes", "label": "Photoshop-parity View Modes", "file_type": "concept", "source_file": "mockups/mask-lab/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On Layers (checker), Overlay rubylith, On Black, On White, B&W matte and Marching Ants \u2014 mirrors Photoshop Select & Mask so the matte can be judged against different backdrops."}, {"id": "mockups_mask_lab_index_refine_edge_brush", "label": "Refine Edge brush (forces trimap 'unknown')", "file_type": "concept", "source_file": "mockups/mask-lab/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Painting refine marks pixels unknown in the trimap regardless of their current FG/BG state, handing them to the matting solver to recover hair detail."}, {"id": "mockups_mask_lab_index_smart_radius", "label": "Smart Radius (gradient-widened trimap band)", "file_type": "concept", "source_file": "mockups/mask-lab/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A second, wider erode/dilate pair is used only where the smoothed luminance gradient exceeds 0.10, and the wide radius is capped at 34px to keep morphology interactive."}, {"id": "mockups_mask_lab_index_mat_preset", "label": "MAT_PRESET matting model presets (guided / vitmatte / zim)", "file_type": "concept", "source_file": "mockups/mask-lab/index.html", "source_location": "742", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The 'deep model' choice is only a radius-factor/epsilon tuple on the guided filter \u2014 it emulates detail strength rather than pretending to run the real weights."}, {"id": "mockups_mask_lab_index_runpipeline", "label": "runPipeline()", "file_type": "code", "source_file": "mockups/mask-lab/index.html", "source_location": "815", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "mockups_mask_lab_index_recompute", "label": "recompute()", "file_type": "code", "source_file": "mockups/mask-lab/index.html", "source_location": "810", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Coalesces non-immediate recomputes into one requestAnimationFrame so slider drags never queue multiple full-pipeline passes."}, {"id": "mockups_mask_lab_index_buildtrimap", "label": "buildTrimap()", "file_type": "code", "source_file": "mockups/mask-lab/index.html", "source_location": "705", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "mockups_mask_lab_index_buildmatte", "label": "buildMatte()", "file_type": "code", "source_file": "mockups/mask-lab/index.html", "source_location": "746", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Re-imposes the trimap's hard FG/BG constraints after the guided filter so only the unknown band is actually solved."}, {"id": "mockups_mask_lab_index_pymattingrefine", "label": "pymattingRefine()", "file_type": "code", "source_file": "mockups/mask-lab/index.html", "source_location": "755", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Close-then-open on the solid core bridges pinholes and drops speckles, but soft edge pixels are left untouched so hair is not hardened."}, {"id": "mockups_mask_lab_index_globalrefine", "label": "globalRefine()", "file_type": "code", "source_file": "mockups/mask-lab/index.html", "source_location": "772", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Smooth / Shift Edge / Contrast / Feather applied in that fixed order \u2014 Photoshop Global Refinements parity."}, {"id": "mockups_mask_lab_index_decontaminate", "label": "decontaminate()", "file_type": "code", "source_file": "mockups/mask-lab/index.html", "source_location": "782", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Iteratively floods known-foreground colour inward (max 22 passes) to unmix background colour out of partially transparent pixels."}, {"id": "mockups_mask_lab_index_autoselect", "label": "autoSelect()", "file_type": "code", "source_file": "mockups/mask-lab/index.html", "source_location": "678", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SAM stand-in: border-colour distance plus a centre prior, thresholded at 1.05x mean, then largest-component + hole-fill + tiny close."}, {"id": "mockups_mask_lab_index_guidedfilter", "label": "guidedFilter()", "file_type": "code", "source_file": "mockups/mask-lab/index.html", "source_location": "410", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "He et al. guided filter on the luminance guide is the edge-aware matting core: it pulls soft alpha onto real luminance edges (hair, fur, fringe)."}, {"id": "mockups_mask_lab_index_boxfilter", "label": "boxFilter()", "file_type": "code", "source_file": "mockups/mask-lab/index.html", "source_location": "382", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separable O(N) running-sum box filter, edge-normalised by valid-window count so borders do not darken."}, {"id": "mockups_mask_lab_index_gaussblur", "label": "gaussBlur()", "file_type": "code", "source_file": "mockups/mask-lab/index.html", "source_location": "450", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three box passes approximate a gaussian, avoiding a real kernel while staying O(N)."}, {"id": "mockups_mask_lab_index_morph", "label": "morph() separable erode/dilate", "file_type": "code", "source_file": "mockups/mask-lab/index.html", "source_location": "430", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "mockups_mask_lab_index_keeplargestcc", "label": "keepLargestCC()", "file_type": "code", "source_file": "mockups/mask-lab/index.html", "source_location": "467", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "mockups_mask_lab_index_fillholes", "label": "fillHoles()", "file_type": "code", "source_file": "mockups/mask-lab/index.html", "source_location": "485", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flood-fills from the image border so only background reachable from outside stays background; everything enclosed becomes foreground."}, {"id": "mockups_mask_lab_index_computeboundary", "label": "computeBoundary()", "file_type": "code", "source_file": "mockups/mask-lab/index.html", "source_location": "801", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "mockups_mask_lab_index_work_max_downscale", "label": "WORK_MAX working-resolution cap (760px)", "file_type": "rationale", "source_file": "mockups/mask-lab/index.html", "source_location": "639", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All CPU pipeline math runs at a downscaled working resolution so the full coarse->trimap->matte->refine chain stays interactive on every slider move."}, {"id": "mockups_mask_lab_index_matte_anything", "label": "hustvl/Matte-Anything", "file_type": "paper", "source_file": "mockups/mask-lab/index.html", "source_location": null, "source_url": "https://github.com/hustvl/Matte-Anything", "captured_at": null, "author": null, "contributor": null}, {"id": "mockups_mask_lab_index_zim", "label": "naver-ai/ZIM (zero-shot matting, ICCV'25)", "file_type": "paper", "source_file": "mockups/mask-lab/index.html", "source_location": null, "source_url": "https://github.com/naver-ai/ZIM", "captured_at": null, "author": null, "contributor": null}, {"id": "mockups_mask_lab_index_vitmatte", "label": "hustvl/ViTMatte", "file_type": "paper", "source_file": "mockups/mask-lab/index.html", "source_location": null, "source_url": "https://github.com/hustvl/ViTMatte", "captured_at": null, "author": null, "contributor": null}, {"id": "mockups_mask_lab_index_pymatting", "label": "pymatting/pymatting", "file_type": "paper", "source_file": "mockups/mask-lab/index.html", "source_location": null, "source_url": "https://github.com/pymatting/pymatting", "captured_at": null, "author": null, "contributor": null}, {"id": "mockups_mask_lab_index_webgpu_sam2", "label": "webgpu-sam2 / transformers.js SAM (in-browser SAM)", "file_type": "paper", "source_file": "mockups/mask-lab/index.html", "source_location": null, "source_url": "https://github.com/lucasgelfond/webgpu-sam2", "captured_at": null, "author": null, "contributor": null}, {"id": "mockups_mask_lab_index_shared_matting_webgl", "label": "shared_matting_webgl (real-time GLSL alpha matting)", "file_type": "paper", "source_file": "mockups/mask-lab/index.html", "source_location": null, "source_url": "https://github.com/kingfolk/shared_matting_webgl", "captured_at": null, "author": null, "contributor": null}, {"id": "mockups_mask_lab_index_photoshop_select_and_mask", "label": "Photoshop Select & Mask (UX reference)", "file_type": "concept", "source_file": "mockups/mask-lab/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "mockups_mask_lab_index_select_and_mask_mockup", "target": "mockups_mask_lab_index_production_mapping", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "mockups/mask-lab/index.html", "source_location": null, "weight": 1.0}, {"source": "mockups_mask_lab_index_select_and_mask_mockup", "target": "mockups_mask_lab_index_view_modes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "mockups/mask-lab/index.html", "source_location": null, "weight": 1.0}, {"source": "mockups_mask_lab_index_select_and_mask_mockup", "target": "mockups_mask_lab_index_ink_depths_palette", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "mockups/mask-lab/index.html", "source_location": null, "weight": 1.0}, {"source": "mockups_mask_lab_index_view_modes", "target": "mockups_mask_lab_index_photoshop_select_and_mask", "relation": "cites", "confidence": "EXTRACTE