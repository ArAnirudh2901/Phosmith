# Phosmith erase service — copy to services/segment/.env and adjust.
# Endpoints: /inpaint (LaMa), /shape/fill (OpenCV). Proxied by the Next.js
# /api/ai/inpaint and /api/ai/shape-mask routes via MASK_SERVICE_URL.

# The Next.js app reaches this service at (set in the phosmith .env.local):
#   MASK_SERVICE_URL=http://127.0.0.1:8001

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8001
MAX_UPLOAD_MB=24
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Shape fill ───────────────────────────────────────────────────────────────
SHAPE_MASK_MAX_SIDE=2048
SHAPE_MASK_MAX_POINTS=10000

# ─── Lazy loading ─────────────────────────────────────────────────────────────
# 0 (default) loads LaMa on first use; 1 preloads it at startup.
SEGMENT_EAGER_MODELS=0

# ─── Model cache (persist across restarts) ────────────────────────────────────
# HuggingFace Spaces with persistent storage: MODEL_CACHE_DIR=/data/models
# MODEL_CACHE_DIR=/data/models
