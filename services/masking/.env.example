# Phosmith depth + selection service — copy to services/masking/.env and adjust.
# Endpoints: /depth (Depth Anything V2) and /sam/embed, /sam/decode (SlimSAM, for
# devices that cannot run selection in the browser). Proxied by the Next.js
# /api/ai/depth and /api/ai/sam/* routes via MASKING_SERVICE_URL.

# The Next.js app reaches this service at (set in the phosmith .env.local):
#   MASKING_SERVICE_URL=http://127.0.0.1:8002

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8002
MAX_UPLOAD_MB=24
# Allow the Next.js dev origin (only relevant if the browser ever calls direct).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Depth Anything V2 (/depth) ───────────────────────────────────────────────
DEPTH_MODEL_ID=depth-anything/Depth-Anything-V2-Small-hf
DEPTH_CACHE_MAX=20
DEPTH_CACHE_MAX_PIXELS=4194304
DEPTH_MAX_SIDE=2048

# ─── SlimSAM (/sam/*) ─────────────────────────────────────────────────────────
SAM_MODEL_ID=nielsr/slimsam-77-uniform
# Image encodings kept in memory (4 MB each).
SAM_CACHE_MAX=16
# cpu (default) | mps | cuda | auto. On an M2, MPS was slower than CPU.
SAM_DEVICE=cpu

# ─── Lazy loading ─────────────────────────────────────────────────────────────
# 0 (default) loads Depth and SlimSAM on first use (smaller resident footprint).
SEGMENT_EAGER_MODELS=0

# ─── Model cache (persist across restarts) ────────────────────────────────────
# HuggingFace Spaces with persistent storage: MODEL_CACHE_DIR=/data/models
# Docker volume:                              MODEL_CACHE_DIR=/models
# Leave unset locally (the HF default already persists).
# MODEL_CACHE_DIR=/data/models
